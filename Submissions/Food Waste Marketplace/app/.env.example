# Copy to .env and fill in. Any service left blank runs on its mock (the demo still works).
# MOCK_<NAME>=1 forces a mock even when its key is set (names: GEMINI, PERCEPTRON, VISA, SOLANA, BACKBOARD).
PORT=3000
PUBLIC_URL=https://yourdomain.com
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me

# Gemini (listing writer + backup vision + Photon Q&A)
GEMINI_API_KEY=

# Perceptron — EITHER the event endpoint (OpenAI-style chat completions)...
PERCEPTRON_URL=
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=
# ...OR Perceptron Isaac hosted on fal.ai
FAL_KEY=

# Visa Acceptance / CyberSource sandbox (Business Center → Key Management → REST shared secret)
CYBS_MERCHANT_ID=
CYBS_KEY_ID=
CYBS_SECRET=

# Solana devnet — run `npm run solana:setup`
SOLANA_PAYER_SECRET=
SOL_USD=150

# Backboard (app.backboard.io → Settings → API Keys)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Tiger Data (Timescale) connection string
DATABASE_URL=

# Photon 2.0 (photon.co/beta): project key, project id, and your agent's user id
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
PHOTON_PLATFORM=imessage
